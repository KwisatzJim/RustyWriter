{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RustyWriter",
  "version": "0.1.0",
  "identifier": "com.jim.rustywriter",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RustyWriter",
        "width": 780,
        "height": 560,
        "resizable": true,
        "minWidth": 620,
        "minHeight": 460,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "appimage", "deb"],
    "icon": ["icons/icon.png"],
    "externalBin": ["binaries/rustywriter-helper"]
  }
}
