{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RustyWriter",
  "version": "0.1.0",
  "identifier": "com.jim.rustywriter",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RustyWriter",
        "width": 860,
        "height": 680,
        "resizable": true,
        "minWidth": 640,
        "minHeight": 540,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "appimage", "deb"],
    "icon": ["icons/icon.png"],
    "externalBin": ["binaries/rustywriter-helper"]
  }
}
